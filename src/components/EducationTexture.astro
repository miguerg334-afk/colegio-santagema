---
interface Props {
	id: string;
	dark?: boolean;
}

const { id, dark = false } = Astro.props;
---

<svg
	class:list={["pointer-events-none absolute inset-0 h-full w-full", dark ? "text-blue-300 opacity-[0.09]" : "text-blue-700 opacity-[0.07]"]}
	aria-hidden="true"
	preserveAspectRatio="xMidYMid slice"
>
	<defs>
		<pattern id={id} width="260" height="220" patternUnits="userSpaceOnUse">
			<!-- Libro abierto -->
			<g transform="translate(22 30) rotate(-8)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
				<path d="M2 6c12-5 22-3 30 4v31c-8-7-18-9-30-4z" />
				<path d="M62 6c-12-5-22-3-30 4v31c8-7 18-9 30-4zM32 10v31" />
			</g>

			<!-- Lápiz -->
			<g transform="translate(178 18) rotate(18)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
				<path d="m5 39 5-14L34 1l10 10-24 24zM10 25l10 10M34 1l10 10M5 39l15-4" />
			</g>

			<!-- Birrete -->
			<g transform="translate(112 112) rotate(5)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
				<path d="m0 13 37-13 37 13-37 14zM13 19v19c15 8 33 8 48 0V19M74 13v26" />
				<circle cx="74" cy="42" r="3" />
			</g>

			<!-- Regla triangular -->
			<g transform="translate(205 157) rotate(-12)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
				<path d="M2 43 25 2l23 41zM18 34l8-14 8 14z" />
			</g>

			<!-- Estrellas de aprendizaje -->
			<g fill="currentColor">
				<path d="m85 87 2 5 5 2-5 2-2 5-2-5-5-2 5-2z" />
				<circle cx="31" cy="174" r="3" />
				<circle cx="238" cy="91" r="2" />
			</g>
		</pattern>
	</defs>
	<rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
