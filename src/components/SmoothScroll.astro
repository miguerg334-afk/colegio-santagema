<button class="back-to-top" type="button" aria-label="Volver arriba" aria-hidden="true" tabindex="-1" data-back-to-top>
	<svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="m5 12 7-7 7 7M12 5v14" />
	</svg>
</button>

<style>
	.back-to-top {
		position: fixed;
		right: clamp(1rem, 2vw, 2rem);
		bottom: clamp(1rem, 2vw, 2rem);
		z-index: 60;
		display: grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		border: 1px solid rgba(255, 255, 255, .3);
		border-radius: 50%;
		background: #152a47;
		color: #fff;
		box-shadow: 0 10px 24px rgba(12, 27, 48, .22);
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transform: translateY(12px);
		transition: opacity .3s ease, transform .3s ease, background-color .3s ease;
	}
	.back-to-top.is-visible { opacity: 1; pointer-events: auto; transform: translateY(0); }
	.back-to-top:hover { background: #1d4ed8; transform: translateY(-3px); }
	.back-to-top:focus-visible { outline: 3px solid #65e2ba; outline-offset: 3px; }
	@media (prefers-reduced-motion: reduce) {
		.back-to-top { transition: none; }
	}
</style>

<script>
	import Lenis from "lenis";

	const lenis = new Lenis({
		autoRaf: true,
		lerp: 0.04,
		anchors: { offset: -96 },
		stopInertiaOnNavigate: true,
	});

	const button = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
	const updateButton = () => {
		if (!button) return;
		const visible = window.scrollY > Math.max(500, window.innerHeight * .75);
		button.classList.toggle("is-visible", visible);
		button.setAttribute("aria-hidden", String(!visible));
		button.tabIndex = visible ? 0 : -1;
	};

	window.addEventListener("scroll", updateButton, { passive: true });
	updateButton();
	button?.addEventListener("click", () => {
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			window.scrollTo(0, 0);
		} else {
			lenis.scrollTo(0, { duration: 1.2 });
		}
	});
</script>
