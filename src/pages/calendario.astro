---
import "../styles/global.css";
import events from "../data/calendar-events.json";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import SeoHead from "../components/SeoHead.astro";
import EducationTexture from "../components/EducationTexture.astro";
import { ArrowLeft, ArrowRight, CalendarDays } from "@lucide/astro";

const parishMonths = [
	{ month: "Septiembre", dates: [["15", "Virgen Dolorosa"], ["24", "San Vicente María Strambi"]] },
	{ month: "Octubre", dates: [["03", "Beato Carlos Houben, presbítero"], ["06", "Beato Isidoro Loor"], ["07", "Nuestra Señora del Rosario"], ["09", "San Inocencio Canaura"], ["16", "Santa Eduvigis"], ["19", "San Pablo de la Cruz"], ["26", "San José Gregorio Hernández"]] },
	{ month: "Noviembre", dates: [["01", "Todos los Santos"], ["02", "Fieles difuntos"], ["03", "San Pío Campidelli"], ["05", "Difuntos pasionistas"], ["06", "Difuntos de los padres de los religiosos"], ["07", "Difuntos benefactores pasionistas"], ["13", "Beato Eugenio Bossilkov"], ["18", "Beato Grimualdo Santamaría"], ["19", "Cátedra de San Pedro"], ["28", "Inicio del Adviento"]] },
	{ month: "Diciembre", dates: [["08", "Inmaculada Concepción"], ["09", "Beato Bernardo María"], ["15", "Inicio de las misas de aguinaldo, día 1 (tentativo)"], ["24", "Misa de Nochebuena"], ["25", "Navidad"], ["31", "Exposición del Santísimo durante todo el día y misa de fin de año"]] },
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/webp" href="/logo.webp" />
		<meta name="viewport" content="width=device-width" />
		<SeoHead title="Calendario escolar 2026–2027 | Colegio Santa Gema" description="Consulta el calendario escolar 2026–2027 del Colegio Santa Gema: actividades, asuetos, efemérides y fechas de la comunidad parroquial." path="/calendario/" image="/calendario/aula-hero.webp" />
	</head>
	<body class="bg-slate-950 font-sans antialiased">
		<SmoothScroll />
		<Header />
		<main>
			<section class="relative isolate min-h-[58svh] overflow-hidden bg-[#071426] px-6 pb-16 pt-28 text-white lg:px-8 lg:pb-20 lg:pt-32">
				<img src="/calendario/aula-hero.webp" alt="" width="2560" height="1920" class="pointer-events-none absolute inset-0 -z-20 h-full w-full object-cover object-[center_63%]" fetchpriority="high" />
				<div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(7,20,38,.86)_0%,rgba(7,20,38,.69)_50%,rgba(7,20,38,.50)_100%)]"></div>
				<div class="relative mx-auto flex min-h-[calc(58svh-11rem)] max-w-7xl items-end">
					<div class="grid w-full gap-10 lg:grid-cols-[1.1fr_.9fr] lg:items-end">
						<div class="min-w-0">
							<p class="mb-5 text-xs font-bold tracking-[.28em] text-emerald-300 uppercase">Año escolar 2026–2027</p>
							<h1 class="max-w-full text-[clamp(3rem,8vw,7rem)] font-semibold leading-[.92] tracking-[-.07em]"><span class="inline-block bg-gradient-to-r from-blue-300 via-white to-emerald-300 bg-clip-text pr-[.12em] text-transparent">Calendario</span><span class="block">escolar</span></h1>
						</div>
						<p class="max-w-lg border-t border-white/30 pt-6 text-lg leading-8 text-slate-200 lg:mb-2">Las fechas que acompañan el aprendizaje y la vida de nuestra comunidad, de septiembre de 2026 a agosto de 2027.</p>
					</div>
				</div>
			</section>

			<section class="relative isolate overflow-hidden bg-[#f7fbff] px-4 py-20 text-slate-900 sm:px-6 lg:px-8 lg:py-24">
				<EducationTexture id="calendar-education-pattern" />
				<div class="relative z-10 mx-auto max-w-7xl">
					<div><p class="text-xs font-bold tracking-[.24em] text-emerald-700 uppercase">Consulta mes a mes</p><h2 class="mt-3 text-4xl font-semibold tracking-[-.05em] sm:text-5xl">Un año lleno de momentos.</h2><p class="mt-4 max-w-2xl leading-7 text-slate-600">Filtra las fechas que te interesan, cambia de mes y selecciona un día para ver sus detalles.</p></div>
					<div class="calendar-filter-bar" role="group" aria-label="Mostrar fechas en el calendario y la agenda">
						<div><p class="calendar-filter-title">¿Qué fechas quieres ver?</p><p class="calendar-filter-help">Tu elección se aplica al calendario y a la lista del mes.</p></div>
						<div class="calendar-filter-options">
							<button type="button" data-filter="all" aria-pressed="true" class="calendar-filter-button is-active">Todas</button>
							<button type="button" data-filter="activity" aria-pressed="false" class="calendar-filter-button"><span class="calendar-filter-dot is-activity" aria-hidden="true"></span>Actividades</button>
							<button type="button" data-filter="anniversary" aria-pressed="false" class="calendar-filter-button"><span class="calendar-filter-dot is-anniversary" aria-hidden="true"></span>Efemérides</button>
							<button type="button" data-filter="holiday" aria-pressed="false" class="calendar-filter-button"><span class="calendar-filter-dot is-holiday" aria-hidden="true"></span>Asuetos</button>
						</div>
					</div>

					<div class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_21rem]" data-calendar>
						<div class="overflow-hidden rounded-[2rem] border border-blue-100 bg-white p-4 shadow-xl shadow-blue-900/10 sm:p-7">
							<div class="flex flex-wrap items-center justify-between gap-4">
								<div><p class="mb-2 text-xs font-bold tracking-[.18em] text-emerald-700 uppercase">Explora el mes</p><h3 class="text-2xl font-semibold capitalize tracking-tight sm:text-3xl" data-month-title aria-live="polite">Septiembre 2026</h3></div>
								<div class="flex gap-2"><button type="button" data-prev class="grid h-11 w-11 place-items-center rounded-full border border-slate-200 transition hover:bg-blue-50" aria-label="Mes anterior"><ArrowLeft size={19} /></button><button type="button" data-next class="grid h-11 w-11 place-items-center rounded-full border border-slate-200 transition hover:bg-blue-50" aria-label="Mes siguiente"><ArrowRight size={19} /></button></div>
							</div>
							<div class="mt-7 grid grid-cols-7 text-center text-xs font-bold text-slate-500 uppercase"><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span></div>
							<div class="mt-3 grid grid-cols-7 gap-1 sm:gap-2" data-day-grid></div>
							<p class="mt-5 text-sm leading-6 text-slate-600">Los puntos de color indican días con fechas del filtro seleccionado. Selecciona un día para leerlas a la derecha.</p>
						</div>
						<aside class="rounded-[2rem] bg-slate-950 p-6 text-white shadow-xl sm:p-8">
							<CalendarDays size={32} strokeWidth={1.5} class="text-emerald-300" />
							<p class="mt-8 text-xs font-bold tracking-[.24em] text-emerald-300 uppercase">En detalle</p>
							<h3 class="mt-3 text-2xl font-semibold" data-selected-title></h3>
							<div class="mt-6 space-y-4" data-selected-events aria-live="polite"></div>
						</aside>
					</div>

					<div class="mt-12"><p class="text-xs font-bold tracking-[.24em] text-emerald-700 uppercase">Agenda del mes</p><h2 class="mt-2 text-3xl font-semibold tracking-tight" data-agenda-title>Fechas de septiembre</h2><p class="mt-2 text-sm text-slate-600" data-agenda-summary aria-live="polite"></p></div>
					<div class="mt-6 grid gap-3 md:grid-cols-2" data-agenda aria-live="polite"></div>
				</div>
			</section>

			<section id="calendario-parroquial" class="parish-calendar" aria-labelledby="parish-calendar-title">
				<div class="parish-calendar-inner">
					<div class="parish-calendar-heading">
						<div><p class="parish-calendar-eyebrow">Calendario especial · 2026</p><h2 id="parish-calendar-title">Fechas de la comunidad parroquial</h2></div>
						<p>Celebraciones y conmemoraciones de la Parroquia Preciosísima Sangre, de septiembre a diciembre de 2026.</p>
					</div>
					<div class="parish-calendar-grid">
						{parishMonths.map(({ month, dates }) => <article class="parish-month"><h3>{month}</h3><ol>{dates.map(([day, title]) => <li><span>{day}</span><p>{title}</p></li>)}</ol></article>)}
					</div>
				</div>
			</section>
		</main>
		<Footer />
		<script define:vars={{ events }}>
			const root = document.querySelector('[data-calendar]');
			const title = root.querySelector('[data-month-title]');
			const grid = root.querySelector('[data-day-grid]');
			const selectedTitle = root.querySelector('[data-selected-title]');
			const selectedEvents = root.querySelector('[data-selected-events]');
			const agendaTitle = document.querySelector('[data-agenda-title]');
			const agendaSummary = document.querySelector('[data-agenda-summary]');
			const agenda = document.querySelector('[data-agenda]');
			const monthNames = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
			const firstMonth = new Date(2026, 8, 1);
			const lastMonth = new Date(2027, 7, 1);
			const today = new Date();
			let visible = today >= firstMonth && today <= new Date(2027, 7, 31) ? new Date(today.getFullYear(), today.getMonth(), 1) : firstMonth;
			let selectedDay = null;
			let filter = 'all';
			const dateKey = (year, month, day) => `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
			const kind = (type) => /Asueto|Feriado/.test(type) ? 'holiday' : type === 'Efeméride' ? 'anniversary' : 'activity';
			const filterNames = { all: 'Todas las fechas', activity: 'Actividades', anniversary: 'Efemérides', holiday: 'Asuetos' };
			const matchesFilter = (event) => filter === 'all' || kind(event.type) === filter;
			const styles = { activity: 'bg-blue-100 text-blue-800', anniversary: 'bg-emerald-100 text-emerald-800', holiday: 'bg-amber-100 text-amber-800' };
			const monthEvents = () => events.filter((event) => event.dates.some((date) => date.startsWith(dateKey(visible.getFullYear(), visible.getMonth(), 1).slice(0, 7))));
			const entry = (event, showDate) => {
				const item = document.createElement('article');
				item.className = 'rounded-2xl border border-slate-200 bg-white p-5 shadow-sm';
				const tag = document.createElement('span');
				tag.className = `inline-block rounded-full px-3 py-1 text-xs font-bold ${styles[kind(event.type)]}`;
				tag.textContent = event.type;
				const heading = document.createElement('p');
				heading.className = 'mt-3 text-sm font-semibold text-blue-700';
				heading.textContent = showDate && !/[a-zA-Záéíóú]/.test(event.dateLabel) ? `${event.dateLabel} de ${monthNames[event.month - 1]}` : event.dateLabel;
				const description = document.createElement('p');
				description.className = 'mt-1 leading-6 text-slate-700';
				description.textContent = event.title;
				item.append(tag, heading, description);
				return item;
			};
			const renderSelected = () => {
				selectedTitle.textContent = selectedDay ? `${selectedDay} de ${monthNames[visible.getMonth()]}` : 'Selecciona un día';
				selectedEvents.replaceChildren();
				const found = selectedDay ? events.filter((event) => event.dates.includes(dateKey(visible.getFullYear(), visible.getMonth(), selectedDay)) && matchesFilter(event)) : [];
				if (!found.length) {
					const note = document.createElement('p'); note.className = 'text-sm leading-7 text-slate-300'; note.textContent = selectedDay ? (filter === 'all' ? 'No hay fechas registradas para este día.' : `No hay ${filterNames[filter].toLowerCase()} para este día. Prueba con “Todas”.`) : 'Selecciona un día con un punto de color para ver sus fechas aquí.'; selectedEvents.append(note); return;
				}
				found.forEach((event) => { const item = document.createElement('div'); item.className = 'border-t border-white/15 pt-4'; const label = document.createElement('p'); label.className = 'text-xs font-bold text-emerald-300'; label.textContent = event.type; const text = document.createElement('p'); text.className = 'mt-2 text-sm leading-6 text-slate-100'; text.textContent = event.title; item.append(label, text); selectedEvents.append(item); });
			};
			const renderAgenda = () => {
				agendaTitle.textContent = `Fechas de ${monthNames[visible.getMonth()]} ${visible.getFullYear()}`;
				agenda.replaceChildren();
				const found = monthEvents().filter(matchesFilter);
				agendaSummary.textContent = `${filterNames[filter]} · ${found.length} ${found.length === 1 ? 'fecha' : 'fechas'} en este mes`;
				if (!found.length) { const note = document.createElement('p'); note.className = 'text-slate-600'; note.textContent = 'No hay fechas en esta categoría para el mes.'; agenda.append(note); return; }
				found.forEach((event) => agenda.append(entry(event, true)));
			};
			const render = () => {
				const year = visible.getFullYear(), month = visible.getMonth();
				title.textContent = `${monthNames[month]} ${year}`;
				grid.replaceChildren();
				const offset = (new Date(year, month, 1).getDay() + 6) % 7;
				for (let i = 0; i < offset; i++) { const spacer = document.createElement('span'); spacer.setAttribute('aria-hidden', 'true'); grid.append(spacer); }
				const days = new Date(year, month + 1, 0).getDate();
				for (let day = 1; day <= days; day++) {
					const date = dateKey(year, month, day);
					const found = events.filter((event) => event.dates.includes(date) && matchesFilter(event));
					const button = document.createElement('button'); button.type = 'button'; button.className = `flex min-h-16 flex-col items-center justify-center gap-1 rounded-xl border text-sm font-semibold transition sm:min-h-20 sm:text-base ${selectedDay === day ? 'border-blue-700 bg-blue-700 text-white' : 'border-blue-100 bg-blue-50/50 text-slate-800 hover:border-blue-500 hover:bg-blue-50'}`; button.setAttribute('aria-label', `${day} de ${monthNames[month]}: ${found.length} ${found.length === 1 ? 'fecha visible' : 'fechas visibles'}`); button.setAttribute('aria-pressed', String(selectedDay === day));
					const number = document.createElement('span'); number.textContent = String(day); button.append(number);
					if (found.length) { const marks = document.createElement('span'); marks.className = 'flex gap-1'; [...new Set(found.map((event) => kind(event.type)))].forEach((type) => { const dot = document.createElement('i'); dot.className = `h-1.5 w-1.5 rounded-full ${selectedDay === day ? 'bg-white' : type === 'holiday' ? 'bg-amber-500' : type === 'anniversary' ? 'bg-emerald-500' : 'bg-blue-600'}`; marks.append(dot); }); button.append(marks); }
					button.addEventListener('click', () => { selectedDay = day; render(); }); grid.append(button);
				}
				root.querySelector('[data-prev]').disabled = visible <= firstMonth;
				root.querySelector('[data-next]').disabled = visible >= lastMonth;
				root.querySelectorAll('[data-prev], [data-next]').forEach((button) => button.classList.toggle('opacity-35', button.disabled));
				renderSelected(); renderAgenda();
			};
			root.querySelector('[data-prev]').addEventListener('click', () => { visible = new Date(visible.getFullYear(), visible.getMonth() - 1, 1); selectedDay = null; render(); });
			root.querySelector('[data-next]').addEventListener('click', () => { visible = new Date(visible.getFullYear(), visible.getMonth() + 1, 1); selectedDay = null; render(); });
			document.querySelectorAll('[data-filter]').forEach((button) => button.addEventListener('click', () => { filter = button.dataset.filter; document.querySelectorAll('[data-filter]').forEach((item) => { const active = item === button; item.setAttribute('aria-pressed', String(active)); item.classList.toggle('is-active', active); }); render(); }));
			render();
		</script>
	</body>
</html>

<style>
	.calendar-filter-bar { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: 2.5rem; padding: 1.4rem 1.6rem; border: 1px solid #dbeafe; border-radius: 1.5rem; background: #fff; box-shadow: 0 12px 28px rgb(30 64 175 / 6%); }
	.calendar-filter-title { margin: 0; color: #0f172a; font-size: 1rem; font-weight: 700; }
	.calendar-filter-help { margin: .25rem 0 0; color: #64748b; font-size: .875rem; line-height: 1.5; }
	.calendar-filter-options { display: flex; flex-wrap: wrap; gap: .5rem; }
	.calendar-filter-button { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 2.75rem; padding: .55rem 1rem; border: 1px solid #bfdbfe; border-radius: 999px; color: #334155; background: #fff; font: inherit; font-size: .875rem; font-weight: 700; cursor: pointer; transition: background .2s ease, border-color .2s ease, color .2s ease; }
	.calendar-filter-button:hover { border-color: #2563eb; background: #eff6ff; }
	.calendar-filter-button.is-active { border-color: #1d4ed8; color: #fff; background: #1d4ed8; }
	.calendar-filter-button.is-active:hover { background: #1e40af; }
	.calendar-filter-button:focus-visible { outline: 3px solid #60a5fa; outline-offset: 3px; }
	.calendar-filter-dot { width: .55rem; height: .55rem; flex: none; border-radius: 50%; }
	.calendar-filter-dot.is-activity { background: #2563eb; }
	.calendar-filter-dot.is-anniversary { background: #10b981; }
	.calendar-filter-dot.is-holiday { background: #f59e0b; }
	.calendar-filter-button.is-active .calendar-filter-dot { background: #fff; }
	@media (max-width: 850px) { .calendar-filter-bar { align-items: start; flex-direction: column; } }
	.parish-calendar { padding: clamp(5rem, 8vw, 8rem) 1.5rem; background: linear-gradient(135deg, #eaf3ff, #f7fbff 55%, #e8f6f0); color: #0f172a; }
	.parish-calendar-inner { width: min(100%, 80rem); margin-inline: auto; }
	.parish-calendar-heading { display: grid; gap: 1.5rem; align-items: end; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); }
	.parish-calendar-eyebrow { margin: 0; color: #047857; font-size: .78rem; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; }
	.parish-calendar-heading h2 { max-width: 46rem; margin: 1rem 0 0; font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 700; line-height: 1.05; letter-spacing: -.055em; }
	.parish-calendar-heading > p { max-width: 29rem; margin: 0; color: #475569; font-size: 1.05rem; line-height: 1.7; }
	.parish-calendar-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 3rem; }
	.parish-month { min-width: 0; padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid #dbeafe; border-radius: 1.75rem; background: #fff; box-shadow: 0 18px 40px rgb(30 64 175 / 7%); }
	.parish-month h3 { margin: 0 0 1.3rem; color: #1d4ed8; font-size: 1.7rem; font-weight: 700; letter-spacing: -.035em; }
	.parish-month ol { margin: 0; padding: 0; list-style: none; }
	.parish-month li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; padding: .8rem 0; border-top: 1px solid #e2e8f0; }
	.parish-month li span { color: #059669; font-weight: 800; }
	.parish-month li p { margin: 0; color: #334155; line-height: 1.5; }
	@media (max-width: 760px) { .parish-calendar-heading, .parish-calendar-grid { grid-template-columns: 1fr; } }
</style>
