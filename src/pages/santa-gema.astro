---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import SeoHead from "../components/SeoHead.astro";
import { ArrowDown, Baby, Heart, BadgeCheck, ArrowRight } from "@lucide/astro";

const timeline = [
	{ year: "1878–1899", title: "Infancia, pérdida y esperanza", text: "Gemma Umberta Pia Galgani nació el 12 de marzo de 1878, cerca de Lucca, en una familia profundamente cristiana. Recibió la Primera Comunión a los nueve años. Más tarde, la muerte de su padre y una grave enfermedad pusieron a prueba a su familia; su recuperación fortaleció una vida de oración y confianza.", icon: Baby },
	{ year: "1899–1903", title: "Oración y fortaleza interior", text: "En sus últimos años, Gema profundizó en una espiritualidad centrada en la Pasión de Cristo. Vivió su fe en la oración, la sencillez y la paciencia ante el sufrimiento. Esa manera de afrontar la vida convirtió su historia personal en un testimonio que empezó a trascender Lucca.", icon: Heart },
	{ year: "1903–1940", title: "Un legado que permanece", text: "Gema murió en Lucca el 11 de abril de 1903, a los 25 años. Su testimonio siguió difundiéndose y, el 2 de mayo de 1940, el papa Pío XII la canonizó. Hoy la familia pasionista celebra su memoria cada 16 de mayo.", icon: BadgeCheck },
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/webp" href="/logo.webp" />
		<meta name="viewport" content="width=device-width" />
		<SeoHead title="Santa Gema Galgani | Colegio Santa Gema" description="Conoce la vida de Santa Gema Galgani, una historia de fe, fortaleza y esperanza." path="/santa-gema/" image="/santa-gema/gemma-hero-background.webp" />
	</head>
	<body class="bg-[#f8fafc] font-sans text-slate-950 antialiased">
		<SmoothScroll />
		<Header />
		<main>
			<section class="relative isolate min-h-[58svh] overflow-hidden bg-[linear-gradient(115deg,#10243d_0%,#1d4261_53%,#236f73_100%)] px-6 pb-16 pt-28 text-white sm:min-h-[60svh] lg:px-8 lg:pb-20 lg:pt-32">
				<img src="/santa-gema/gemma-hero-background.webp" width="600" height="400" alt="" class="pointer-events-none absolute inset-0 -z-20 h-full w-full object-cover object-[64%_center] sm:object-[center_42%]" fetchpriority="high" />
				<div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(7,20,38,.86)_0%,rgba(7,20,38,.69)_50%,rgba(7,20,38,.50)_100%)]"></div>

				<div class="relative z-10 mx-auto flex min-h-[calc(58svh-11rem)] max-w-7xl items-end sm:min-h-[calc(60svh-11rem)]">
					<div class="w-full">
						<div>
							<p class="mb-4 text-xs font-semibold tracking-[.3em] text-emerald-200 uppercase">Nuestra inspiración</p>
							<h1 class="text-[clamp(3rem,11vw,8rem)] font-bold leading-[.88] tracking-[-.07em] sm:leading-[.82]"><span class="bg-gradient-to-r from-blue-300 via-white to-emerald-300 bg-clip-text text-transparent">Santa Gema<br />Galgani</span></h1>
						</div>

					</div>
				</div>
			</section>

			<section class="saint-history relative overflow-hidden px-6 py-14 text-slate-900 sm:py-20 lg:px-8 lg:py-28">
				<div class="pointer-events-none absolute -right-28 top-12 select-none font-serif text-[clamp(12rem,30vw,28rem)] leading-none text-blue-700/[.035]" aria-hidden="true">G</div>
				<div class="relative mx-auto max-w-7xl">
					<header class="mx-auto max-w-3xl text-center">
						<p class="flex items-center justify-center gap-3 text-xs font-bold tracking-[.25em] text-emerald-700 uppercase"><span class="h-px w-8 bg-emerald-500"></span>Su historia<span class="h-px w-8 bg-emerald-500"></span></p>
						<h2 class="mt-4 text-4xl font-bold tracking-[-.04em] text-slate-950 sm:text-5xl">Una vida de fe y esperanza.</h2>
						<p class="mx-auto mt-4 max-w-xl text-base leading-7 text-slate-600">De su infancia en Italia a un legado que continúa inspirando.</p>
					</header>

					<div class="saint-storyline relative mt-16">
						<img src="/santa-gema/gemma-timeline-cutout.webp" alt="" aria-hidden="true" loading="lazy" class="saint-story-presence" />
						{timeline.map(({ year, title, text, icon: Icon }, index) => (
							<div class:list={["saint-story-beat", index % 2 === 0 ? "is-right" : "is-left"]}>
								<article class="saint-story-copy">
									<div class="flex items-center gap-3 text-[.65rem] font-bold tracking-[.2em] text-blue-700 uppercase"><span class="h-px w-8 bg-blue-400"></span>Etapa {String(index + 1).padStart(2, "0")}</div>
									<p class="saint-story-year mt-3 text-[clamp(2.1rem,9vw,3rem)] font-bold tracking-[-.05em] sm:text-6xl">{year}</p>
									<div class="mt-3 flex items-center gap-3"><span class="saint-story-icon"><Icon size={19} strokeWidth={1.7} /></span><h3 class="text-2xl font-bold leading-tight text-slate-900 sm:text-3xl">{title}</h3></div>
									<p class="mt-4 max-w-md text-base leading-7 text-slate-600">{text}</p>
								</article>
								<div class="saint-story-node" aria-hidden="true"><span>{String(index + 1).padStart(2, "0")}</span>{index < timeline.length - 1 && <ArrowDown size={18} class="saint-story-down" />}</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<section class="relative isolate overflow-hidden bg-gradient-to-br from-[#e9f3ff] via-[#d5ecef] to-[#a9d6d5] px-6 py-20 text-slate-900 lg:px-8 lg:py-24">
				<div class="absolute inset-0 opacity-[.12]" style="background-image: radial-gradient(rgba(29,78,216,.65) .7px, transparent 1px); background-size: 20px 20px;"></div>
				<div class="absolute -right-20 -top-40 h-[32rem] w-[32rem] rounded-full border border-blue-700/10"></div>
				<div class="relative mx-auto grid max-w-7xl gap-8 md:grid-cols-[1fr_auto] md:items-center">
					<div><p class="text-xs font-bold tracking-[.24em] text-emerald-800 uppercase">Lo que permanece</p><h2 class="mt-3 max-w-3xl text-3xl font-bold leading-tight sm:text-4xl">Fe para atravesar la dificultad. Amor para servir.</h2><p class="mt-4 max-w-2xl leading-7 text-slate-700">Su ejemplo inspira a nuestra comunidad a vivir con esperanza, sencillez y compasión.</p></div>
					<a href="/#institucion" class="group inline-flex items-center justify-center gap-3 rounded-full border border-blue-800/20 bg-blue-700 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-900/10 transition hover:-translate-y-1 hover:bg-slate-900">Conocer el colegio <ArrowRight size={17} class="transition group-hover:translate-x-1" /></a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
