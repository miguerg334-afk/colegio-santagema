---
import "../styles/global.css";
import EducationTexture from "../components/EducationTexture.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/webp" href="/logo.webp" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<meta name="generator" content={Astro.generator} />
		<title>Página no encontrada | Colegio Santa Gema</title>
	</head>
	<body class="bg-slate-950 font-sans antialiased">
		<SmoothScroll />
		<Header />

		<main class="relative flex min-h-screen items-center overflow-hidden bg-slate-950 px-6 pb-16 pt-32 text-white lg:px-8">
			<EducationTexture id="not-found-education-pattern" dark />
			<div class="absolute left-1/2 top-1/2 h-[34rem] w-[34rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-600/20 blur-3xl" aria-hidden="true"></div>
			<div class="absolute bottom-0 left-0 h-72 w-72 rounded-full bg-emerald-400/10 blur-3xl" aria-hidden="true"></div>

			<section class="relative z-10 mx-auto max-w-4xl text-center">
				<a href="/" class="mx-auto inline-flex rounded-full bg-white/10 p-3 ring-1 ring-white/15 transition-all duration-300 hover:scale-105 hover:bg-white/15 hover:ring-emerald-300/50" aria-label="Volver al inicio">
					<img src="/logo.webp" alt="" class="h-16 w-16 object-contain sm:h-20 sm:w-20" />
				</a>

				<p class="mt-8 text-sm font-semibold tracking-[0.24em] text-emerald-300 uppercase">Página no encontrada</p>
				<h1 class="mt-3 bg-gradient-to-b from-white via-blue-200 to-blue-500 bg-clip-text text-[clamp(7rem,25vw,15rem)] font-semibold leading-[0.82] tracking-[-0.08em] text-transparent">404</h1>
				<h2 class="mt-8 text-3xl font-semibold tracking-tight sm:text-5xl">Parece que esta página tomó otro camino.</h2>
				<p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
					El enlace que visitaste no existe o cambió de dirección. Puedes regresar al inicio y continuar conociendo nuestra comunidad educativa.
				</p>

				<div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
					<a href="/" class="inline-flex items-center justify-center gap-2 rounded-full bg-emerald-400 px-6 py-3 text-sm font-semibold text-slate-950 transition-all duration-300 hover:-translate-y-1 hover:bg-emerald-300 hover:shadow-xl hover:shadow-emerald-950/30">
						<svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 10H4m5-5-5 5 5 5" stroke-linecap="round" stroke-linejoin="round" /></svg> Volver al inicio
					</a>
					<a href="/#oferta" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-1 hover:border-blue-300/60 hover:bg-white/10">
						Ver oferta académica <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" /></svg>
					</a>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
