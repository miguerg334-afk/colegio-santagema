---
import "../styles/global.css";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import SeoHead from "../components/SeoHead.astro";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/webp" href="/logo.webp" />
		<meta name="viewport" content="width=device-width" />
		<SeoHead title="Contacto | Colegio Santa Gema" description="Contacta al Colegio Santa Gema en Caracas para consultas generales o admisiones y accede al formulario oficial de admisión." path="/contacto/" image="/galeria/35-familias-en-el-colegio.webp" />
	</head>
	<body class="bg-slate-950 font-sans antialiased">
		<SmoothScroll />
		<Header />
		<main>
			<section class="relative isolate min-h-[60svh] overflow-hidden bg-[#10243d] px-6 pb-10 pt-28 text-white lg:px-8 lg:pb-12 lg:pt-32">
				<img src="/galeria/35-familias-en-el-colegio.webp" alt="" width="2400" height="1600" class="pointer-events-none absolute inset-0 -z-20 h-full w-full object-cover object-center" fetchpriority="high" />
				<div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(7,20,38,.56)_0%,rgba(7,20,38,.42)_50%,rgba(7,20,38,.28)_100%)]"></div>
				<div class="relative z-10 mx-auto flex min-h-[calc(60svh-11rem)] max-w-7xl items-end">
					<div><p class="mb-4 text-xs font-bold uppercase tracking-[.24em] text-emerald-200">Estamos para ayudarte</p><h1 class="text-[clamp(4rem,10vw,8.5rem)] font-semibold leading-[.82] tracking-[-.07em]"><span class="bg-gradient-to-r from-blue-300 via-white to-emerald-300 bg-clip-text text-transparent">Contacto</span></h1></div>
				</div>
			</section>
			<ContactSection />
		</main>
		<Footer />
	</body>
</html>
